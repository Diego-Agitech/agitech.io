---
// Ported from template-parts/block/hero-home.php
import Cta from './Cta.astro';
export interface Props {
  title?: string;
  subTitle?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
  bottomLine?: boolean;
}
const { title, subTitle, cta, bottomLine = false } = Astro.props;
---
<section class={`banner-sec home-banner dark-bg ${bottomLine ? 'bottom-line-img' : ''}`}>
  <div class="container">
    <div class="row">
      {(title || subTitle) && (
        <div class="col-lg-7 col-md-7 col-sm-12 col-12">
          <div class="text">
            {title && <h6>{title}</h6>}
            {subTitle && <h2>{subTitle}</h2>}
            {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} />}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
