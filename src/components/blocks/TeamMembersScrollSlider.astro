---
// Ported from template-parts/block/team-members-scroll-slider.php.
// Simplified: static scroll row (owl-carousel JS deferred).
export interface Props {
  subHeading?: string;
  mainHeading?: string;
  teamMembers?: { image?: { url: string; alt?: string }; name?: string; role?: string }[];
}
const { subHeading, mainHeading, teamMembers = [] } = Astro.props;
---
<section class="certified-experts-section">
  <div class="container">
    {subHeading && <h6>{subHeading}</h6>}
    {mainHeading && <h3>{mainHeading}</h3>}
    {teamMembers.length > 0 && (
      <div class="experts-slider">
        {teamMembers.map(member => (
          <div class="expert-member">
            {member.image && <img src={member.image.url} alt={member.image.alt ?? member.name ?? ''}>}
            <div class="expert-info">
              {member.name && <h5>{member.name}</h5>}
              {member.role && <h6>{member.role}</h6>}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
