---
// Ported from template-parts/block/team-members.php.
// Simplified: single flat grid instead of the JS tab/chunk-of-3 pagination.
import { blockImg } from '../../lib/img';
export interface Props {
  title?: string;
  subTitle?: string;
  teamMembers?: { image?: string; name?: string; role?: string; introduction?: string; linkedinUrl?: string; linkedinLabel?: string }[];
}
const { title, subTitle, teamMembers = [] } = Astro.props;
---
<section class="our-team-section">
  <div class="container">
    <div class="row">
      <div class="col-lg-3 col-md-3 col-sm-12 col-12">
        <div class="left-content">{title && <h6>{title}</h6>}</div>
      </div>
      <div class="col-lg-9 col-md-9 col-sm-12 col-12">
        <div class="right-content">
          {subTitle && <div class="title"><h3>{subTitle}</h3></div>}
          <div class="row items-wrap">
            {teamMembers.map(m => (
              <div class="col-lg-4 col-md-6 col-12 item">
                <div class="item-wrap">
                  <div class="img">{m.image && <img src={blockImg(m.image)} alt={m.name ?? ''}>}</div>
                  <div class="content">
                    {m.name && <h6>{m.name}</h6>}
                    {m.role && <p class="role">{m.role}</p>}
                    {m.introduction && <p>{m.introduction}</p>}
                    {m.linkedinUrl && (
                      <div class="dark-link"><a href={m.linkedinUrl} target="_blank" rel="noopener">{m.linkedinLabel || 'LinkedIn'}</a></div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
