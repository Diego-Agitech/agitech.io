---
// Ported from template-parts/block/recruitment-cta.php
import Cta from './Cta.astro';
import { blockImg } from '../../lib/img';
export interface Props {
  title?: string;
  subTitle?: string;
  contentDetails?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
  image?: string;
}
const { title, subTitle, contentDetails, cta, image } = Astro.props;
---
<section class="recruiting-section">
  <div class="container">
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-12 col-12 d-flex align-items-center">
        <div class="content">
          {title && <h6>{title}</h6>}
          {subTitle && <h4>{subTitle}</h4>}
          {contentDetails && <Fragment set:html={contentDetails} />}
          {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} />}
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        {image && <img src={blockImg(image)} alt="">}
      </div>
    </div>
  </div>
</section>
