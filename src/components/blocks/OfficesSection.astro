---
// New block: "Nos bureaux" — added when Agitech grew to 3 offices (BE).
// Locally scoped styles, reuses existing tokens only.
export interface Props {
  title?: string;
  subTitle?: string;
  mapLabel?: string;
  offices?: { city?: string; address?: string }[];
}
const { title, subTitle, mapLabel = 'Voir sur la carte', offices = [] } = Astro.props;
---
<section class="offices-section" id="bureaux">
  <div class="container">
    <div class="offices-title">
      {title && <h3>{title}</h3>}
      {subTitle && <p>{subTitle}</p>}
    </div>
    {offices.length > 0 && (
      <div class="offices-grid">
        {offices.map(o => (
          <a
            class="office-card"
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${o.address}, ${o.city}`)}`}
            target="_blank"
            rel="noopener"
          >
            {o.city && <h5>{o.city}</h5>}
            {o.address && <p>{o.address}</p>}
            <span class="office-map-link">{mapLabel}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .offices-section {
    padding: 5rem 0;
    background: var(--offwhite, #f7f7f7);
  }
  .offices-title {
    max-width: 560px;
    margin: 0 auto 2.75rem;
    text-align: center;
  }
  .offices-title h3 {
    font-size: 1.9rem;
    margin-bottom: 0.75rem;
  }
  .offices-title p {
    color: var(--muted, #6b6b6b);
  }
  .offices-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .office-card {
    display: block;
    background: var(--white, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 16px;
    padding: 1.75rem;
    transition: border-color 0.25s, transform 0.25s;
  }
  .office-card:hover {
    border-color: var(--violet, #984895);
    transform: translateY(-4px);
  }
  .office-card h5 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }
  .office-card p {
    color: var(--muted, #6b6b6b);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .office-map-link {
    color: var(--violet, #984895);
    font-weight: 600;
    font-size: 0.88rem;
  }
  @media (max-width: 900px) {
    .offices-grid { grid-template-columns: 1fr; }
  }
</style>
