---
// Ported from template-parts/block/open-positions.php.
// The live job list lives on the Odoo recruitment portal (its own domain).
// `portalUrl` renders one prominent button straight to that list — fastest
// path for a candidate. `jobs` is the older per-role link list, kept as a
// fallback for any page still using it.
export interface Props {
  title?: string;
  subTitle?: string;
  jobs?: { jobTitle?: string; link?: string }[];
  portalUrl?: string;
  portalLabel?: string;
}
const { title, subTitle, jobs = [], portalUrl, portalLabel } = Astro.props;
---
<section class="open-positions-section dark-bg">
  <div class="container-sm">
    <div class="row">
      <div class="col-lg-12 col-md-12 col-sm-12 col-12">{title && <h6>{title}</h6>}</div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        <div class="left-content">{subTitle && <h3>{subTitle}</h3>}</div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        <div class="right-content">
          {portalUrl ? (
            <div class="primary-btn">
              <a href={portalUrl} target="_blank" rel="noopener">{portalLabel || 'Voir tous nos postes ouverts'}</a>
            </div>
          ) : jobs.length > 0 && (
            <ul>{jobs.map(j => <li><a href={j.link} target="_blank" rel="noopener">{j.jobTitle}</a></li>)}</ul>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
