---
// Ported from template-parts/block/open-positions.php
export interface Props {
  title?: string;
  subTitle?: string;
  jobs?: { jobTitle?: string; link?: string }[];
  iframeUrl?: string;
}
const { title, subTitle, jobs = [], iframeUrl } = Astro.props;
---
<section class="open-positions-section dark-bg">
  <div class="container-sm">
    <div class="row">
      <div class="col-lg-12 col-md-12 col-sm-12 col-12">{title && <h6>{title}</h6>}</div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-12">
        <div class="left-content">{subTitle && <h3>{subTitle}</h3>}</div>
      </div>
      {!iframeUrl && (
        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
          <div class="right-content">
            {jobs.length > 0 && (
              <ul>{jobs.map(j => <li><a href={j.link} target="_blank" rel="noopener">{j.jobTitle}</a></li>)}</ul>
            )}
          </div>
        </div>
      )}
    </div>
    {iframeUrl && (
      <div class="jobs-iframe-wrap">
        <iframe src={iframeUrl} title="Postes ouverts" loading="lazy"></iframe>
      </div>
    )}
  </div>
</section>

<style>
  /* Live job list pulled straight from the Odoo recruitment portal — postes
     change over time there, so this stays an iframe rather than hardcoded copy. */
  .jobs-iframe-wrap {
    margin-top: 2.5rem;
    border-radius: 16px;
    overflow: hidden;
    background: var(--white, #fff);
  }
  .jobs-iframe-wrap iframe {
    display: block;
    width: 100%;
    height: 900px;
    border: 0;
  }
</style>
