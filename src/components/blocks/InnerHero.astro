---
// Ported from template-parts/block/inner-hero.php
import Cta from './Cta.astro';
import { blockImg } from '../../lib/img';
export interface Props {
  logo?: string;
  title?: string;
  subTitle?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
  image?: string;
  bottomLine?: boolean;
  logoAtBottom?: boolean;
}
const { logo, title, subTitle, cta, image, bottomLine = false, logoAtBottom = false } = Astro.props;
---
<section class={`banner-sec inner-pages-banner dark-bg ${bottomLine ? 'bottom-line-img' : ''}`}>
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-md-12 col-sm-12 col-12">
        <div class={`text ${logoAtBottom ? 'logo-bottom' : ''}`}>
          {logo && <div class="at-odoo-logo"><img src={blockImg(logo)} alt=""></div>}
          {title && <h6>{title}</h6>}
          {subTitle && <h2>{subTitle}</h2>}
          {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} wrapClass="light-btn" />}
        </div>
      </div>
    </div>
  </div>
  {image && <div class="right-img"><img src={blockImg(image)} alt=""></div>}
</section>
