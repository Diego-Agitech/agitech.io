---
// Ported from template-parts/block/featured-cases.php.
// Simplified: no owl-carousel JS (deferred), cases passed in already resolved
// from the businessCases collection instead of the WP AJAX tab listing.
import Cta from './Cta.astro';
export interface Props {
  bgClass?: string;
  title?: string;
  subTitle?: string;
  cta?: { label?: string; url?: string; newTab?: boolean };
  cases?: { title: string; href: string; image?: { url: string; alt?: string }; caseType?: string; needs?: string[] }[];
}
const { bgClass = '', title, subTitle, cta, cases = [] } = Astro.props;
---
<section class={`we-implemented-section ${bgClass}`}>
  <div class="container">
    <div class="text-center">
      <div class="title">
        {title && <h6>{title}</h6>}
        {subTitle && <h3>{subTitle}</h3>}
      </div>
      <div class="row items-wrap">
        {cases.map(c => (
          <div class="item">
            <a href={c.href}>
              <div class="field">
                <div class="img">{c.image && <img src={c.image.url} alt={c.image.alt ?? c.title}>}</div>
                <div class="content">
                  {c.caseType && <div class="case_types"><span class="green-text">{c.caseType}</span></div>}
                  <h6>{c.title}</h6>
                  {c.needs && c.needs.length > 0 && <ul>{c.needs.map(n => <li>{n}</li>)}</ul>}
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
      {cta && <Cta label={cta.label} url={cta.url} newTab={cta.newTab} />}
    </div>
  </div>
</section>
