---
// Ported from template-parts/block/our-services.php
export interface Props {
  title?: string;
  subTitle?: string;
  services?: { title?: string; price?: string; link?: string; linkLabel?: string; features?: { included?: boolean; text?: string }[] }[];
}
const { title, subTitle, services = [] } = Astro.props;
---
<section class="our-services-section dark-bg">
  <div class="container">
    <div class="text-center">
      <div class="title">
        {title && <h2>{title}</h2>}
        {subTitle && <h6>{subTitle}</h6>}
      </div>
      {services.length > 0 && (
        <div class="row our-services-content">
          {services.map(s => (
            <div class="col-lg-4 col-md-4 col-sm-12 col-12 item">
              <a href={s.link ?? '#'} class="item-wrap">
                {s.title && <h4>{s.title}</h4>}
                {s.features && s.features.length > 0 && (
                  <ul class="p-0">{s.features.map(f => <li>{f.included ? '✓' : '✗'} {f.text}</li>)}</ul>
                )}
                {s.price && (
                  <div class="tier-price">
                    {s.price}
                    {s.price.includes('€') && <span class="price-vat">HTVA</span>}
                  </div>
                )}
                <span class="light-page-link">{s.linkLabel}</span>
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
