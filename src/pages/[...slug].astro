---
// Generic renderer for any FR page in the Keystatic `pages` collection (except the
// homepage, which stays a dedicated index.astro since it lives at "/", not "/<slug>/").
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const slugs = await reader.collections.pages.list();
  const entries = await Promise.all(
    slugs
      .filter((slug) => slug !== 'accueil')
      .map(async (slug) => ({ slug, entry: await reader.collections.pages.read(slug) }))
  );
  return entries
    .filter(({ entry }) => entry && entry.lang === 'fr')
    .map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));
}

const { entry } = Astro.props;
const blocks = entry.blocks;
---
<Layout
  lang="fr"
  title={entry.seoTitle || entry.title}
  description={entry.seoDescription ?? ''}
  canonical={`https://agitech.io/${Astro.params.slug}/`}
>
  <Header slot="header" lang="fr" />
  <main>
    <BlockRenderer blocks={blocks} />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
