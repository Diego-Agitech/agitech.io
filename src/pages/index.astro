---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  lang="fr"
  title="Agitech — Partenaire Odoo"
  description="Agitech, partenaire Odoo pour l'implémentation, la migration et le support ERP."
  canonical="https://agitech.io/"
>
  <Header slot="header" lang="fr" />
  <main>
    <section class="container">
      <h1>Agitech — site en cours de migration vers Astro</h1>
      <p>Contenu réel à brancher depuis les collections Keystatic (pages/blog/business-cases).</p>
    </section>
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
