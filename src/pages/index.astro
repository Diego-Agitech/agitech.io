---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';

// Real content scraped from agitech.io (2026-08-22) — first migrated page, used to
// validate the block-builder pipeline before doing the other 41 pages.
// Image URLs still point at the live WP media library (asset download/rehosting is a
// separate pass); trust-logo alt text was empty on WP too — carried over as-is.
const blocks = [
  {
    discriminant: 'heroHome',
    value: {
      title: '98 entreprises nous font déjà confiance',
      subTitle: 'Odoo, adapté à votre PME. Pas l’inverse.',
      cta: { label: 'Parler à un expert', url: '/contact-us/' },
      bottomLine: true,
      image: { url: 'https://agitech.io/wp-content/uploads/2025/06/banner-bg-1.svg', alt: 'banner-bg-1' },
    },
  },
  {
    discriminant: 'teamMembersScrollSlider',
    value: {
      subHeading: 'Partenaire Odoo Silver',
      mainHeading: 'Experts certifiés & passionnés',
      teamMembers: [
        { name: 'Diego', role: 'Dir. & Project Manager', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-7.jpg', alt: 'Diego' } },
        { name: 'Sam', role: 'Dir. & Project Manager', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-5.jpg', alt: 'Sam' } },
        { name: 'Pierre', role: 'Dir. Technique', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-3.jpg', alt: 'Pierre' } },
        { name: 'Anais', role: 'Business Analyst', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-6.jpg', alt: 'Anais' } },
        { name: 'Marc', role: 'Business Analyst', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-1.jpg', alt: 'Marc' } },
        { name: 'Adrien', role: 'Business Analyst', image: { url: 'https://agitech.io/wp-content/uploads/2025/09/team-mem-4.jpg', alt: 'Adrien' } },
        { name: 'Junior', role: 'Developpeur', image: { url: 'https://agitech.io/wp-content/uploads/2026/02/Nouveau-projet.jpg', alt: 'Junior' } },
        { name: 'Benjamin', role: 'Sr. Business Analyst', image: { url: 'https://agitech.io/wp-content/uploads/2025/10/team-mem-6-copy-4.jpg', alt: 'Benjamin' } },
      ],
    },
  },
  {
    discriminant: 'helpBlock',
    value: {
      bgClass: 'lighter-gray-bg',
      title: 'Dites-nous vos besoins',
      headingTitle: 'Comment pouvons-nous vous aider ?',
      cards: [
        { title: 'Implémenter Odoo', subTitle: 'Mon entreprise tourne sur excel ou un ERP duquel je ne suis pas satisfait', link: '/odoo-erp/', linkLabel: 'Découvrir Odoo' },
        { title: 'Améliorer mon Odoo', subTitle: 'Mon entreprise est déjà sur Odoo et je cherche un partenaire pour m’aider.', link: '/jobs/', linkLabel: 'Notre équipe' },
        { title: 'Développer sur mesure', subTitle: 'Je recherche des experts PhP, Python, Magento, Hubspot ou WordPress', link: '/development/', linkLabel: 'Développement' },
        { title: 'Réaliser une Analyse', subTitle: 'Coût et ROI d’un nouvel ERP. Due Diligence pour M&A. Roadmap et Stratégie informatique.', link: '/contact-us/', linkLabel: 'Discutons' },
      ],
      cta: { label: 'prendre rendez-vous', url: '/contact-us/' },
    },
  },
  {
    discriminant: 'heroImageBelow',
    value: {
      imageBelow: { url: 'https://agitech.io/wp-content/uploads/2025/05/Agitech_-_Maurine_Toussaint-45-scaled-e1747922226565.jpg', alt: '' },
    },
  },
  {
    discriminant: 'whyChooseUs',
    value: {
      bgClass: 'white-bg',
      title: 'Pourquoi Agitech ?',
      image: { url: 'https://agitech.io/wp-content/uploads/2025/06/why-choose-us-sec-img-scaled.jpg', alt: 'why-choose-us-img' },
      items: [
        { title: 'Patrons de PME & Expert', content: '<ul><li>Vous parlez à quelqu’un qui comprend la technique software & Odoo.</li><li>Et les réalités d’un dirigeant de PME.</li></ul>' },
        { title: 'L’intégrité comme standard.', content: '<ul><li>On ne vous vend que ce dont vous avez besoin.</li><li>On dit non quand c’est mieux pour vous.</li></ul>' },
        { title: '96% de clients fidèles', content: '<ul><li>Ce n’est pas un hasard.</li><li>Pas de miracle, juste du bon travail.</li></ul>' },
      ],
      cta: { label: 'notre équipe', url: '/jobs/' },
    },
  },
  {
    discriminant: 'ourServices',
    value: {
      title: 'Nos services & solutions',
      subTitle: 'Rester compétitif, c’est une question d’outils et de méthode. Confier votre ERP à des experts.',
      services: [
        { title: 'Projet ERP Odoo', link: '/odoo-erp/', linkLabel: 'Découvrir Odoo', points: ['Odoo Ecommerce & PIM', 'Odoo CRM', 'Odoo ERP', 'Odoo MRP', 'Odoo Comptabilité', 'Odoo Dashboard & Reporting', 'Paiement: Stripe & Ingenico'] },
        { title: 'Solution sur mesure', link: '/development/', linkLabel: 'Développement', points: ['PHP', 'Python', 'Java Script', 'WordPress', 'HubSpot'] },
        { title: 'Infrastructure IT', link: '/infrastructure-it/', linkLabel: 'Infrastructure IT', points: ['Serveur Cloud Azure', 'Serveur Cloud AWS', 'Maintenance', 'Sécurité', 'Réseau'] },
      ],
    },
  },
  {
    discriminant: 'trustOnUs',
    value: {
      title: '92 PME nous font déjà confiance',
      subTitle: 'Patron de PME, nous savons que la qualité d’un ERP se mesure à son impact réel sur votre entreprise, pas au nombre de fonctionnalité.',
      logos: [
        'Image-logo-proactivedrive.png', 'Image23.png', 'Image22.png', 'Image41.png', 'Image40.png', 'Image39.png',
        'Image-logo-supersec.png', 'Image37.png', 'Image35.png', 'Image34.png', 'Image33.png', 'Image36.png',
        'Image32.png', 'Image31.png', 'Image30.png', 'Image29.png', 'Image28.png', 'Image-logo-artemia.png',
        'Image26.png', 'Image56.png', 'Image55.png', 'Image-logo-fernatech.png', 'Image52.png', 'Image50.png',
        'Image49.png', 'Image48.png', 'Image47.png', 'Image46.png', 'Image45.png', 'Image-logo-IPM.png',
      ].map(f => ({ url: `https://agitech.io/wp-content/uploads/2026/05/${f}`, alt: '' })),
    },
  },
  {
    discriminant: 'featuredCases',
    value: {
      title: 'Nous mesurons notre succès aux résultats',
      subTitle: 'Nous avons implémenté Odoo chez eux',
      cases: [
        { title: 'RomaForEurope', href: '/business-cases/romaforeurope-erp/', caseType: 'odoo', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/Capture-decran-2025-05-22-a-12.31.21.png', alt: 'RomaForEurope' }, needs: ['Comptabilité', 'Gestion financière', 'Gestion des dons et subventions', 'Gestion des dépenses'] },
        { title: 'Break The Ice', href: '/business-cases/breaktheice-erp/', caseType: 'odoo', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/BTI2.webp', alt: 'BreakTheice' }, needs: ['Gestion des événements', 'Comptabilité et Facturation', 'Double CRM pour la demande et l’offre', 'API entre Umbraco et Odoo'] },
        { title: 'Lastlink', href: '/business-cases/lastlink-erp/', caseType: 'odoo', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/telechargement.jpeg', alt: 'immobilier bruxelles' }, needs: ['Restructuration des données de leur Odoo', 'Personnalisation App Contact', 'Clarté au sein de leur Odoo', 'Double CRM'] },
        { title: 'Fernatech', href: '/business-cases/fernatech-erp/', caseType: 'odoo', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/ferna.webp', alt: '' }, needs: ['Automatisation standard d’Odoo', 'Service sur site', 'Comptabilité et facturation', 'Gestion des devis'] },
      ],
    },
  },
  {
    discriminant: 'creditedAssistance',
    value: {
      title: 'Agitech est crédité pour ces aides.',
      subTitle: 'Digitaliser c’est bien, avec des primes c’est mieux',
      cta: { label: 'prendre rendez-vous', url: '/contact-us/' },
      details: [
        { title: 'Bruxelles > entre 25 et 50%', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/bruxelles-logo.svg', alt: '' } },
        { title: 'Wallonie > jusqu’à 50%', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/cheques-logo.svg', alt: '' } },
        { title: 'En France > Entre 20 et 30%', image: { url: 'https://agitech.io/wp-content/uploads/2025/05/credit-dimpot-logo.svg', alt: '' } },
      ],
    },
  },
  {
    discriminant: 'talkToUs',
    value: {
      bgClass: 'lighter-gray-bg',
      image: { url: 'https://agitech.io/wp-content/uploads/2025/06/sam-profile.jpg', alt: 'sam-profile-img' },
      title: 'Parlez de votre projet avec Sam',
      subTitle: 'Pas de commercial chez Agitech, on se parle directement entre patron de PME.',
      // Two WP paragraphs joined — the Calendly popup script (window.Calendly widget) is
      // deferred, this CTA links straight to the contact page instead.
      contentDetails:
        '<p>Besoin d’un avis franc, d’une estimation budgétaire à la volée ? Vous pouvez directement réserver un visio call avec moi via le lien ci-dessous.</p>' +
        '<p>Si votre demande est urgente, vous pouvez m’écrire à l’adresse suivante: Sam (at) agitech.io</p>',
      cta: { label: 'Discuter avec Sam', url: '/contact-us/' },
    },
  },
];
---
<Layout
  lang="fr"
  title="Agitech — Partenaire Odoo"
  description="Agitech, partenaire Odoo pour l'implémentation, la migration et le support ERP."
  canonical="https://agitech.io/"
>
  <Header slot="header" lang="fr" />
  <main>
    <BlockRenderer blocks={blocks.slice(0, 1)} />
    <div class="brand-bar"></div>
    <BlockRenderer blocks={blocks.slice(1)} />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
