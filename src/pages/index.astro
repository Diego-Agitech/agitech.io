---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlockRenderer from '../components/BlockRenderer.astro';

// Demo fixture — real content will come from the Keystatic `pages` collection
// once the WP content is migrated. Proves the block-renderer wiring end to end.
const blocks = [
  {
    discriminant: 'heroHome',
    value: {
      title: 'Partenaire Odoo',
      subTitle: 'Agitech — implémentation, migration et support ERP',
      cta: { label: 'Discutons de votre projet', url: '/contact-us/' },
    },
  },
  {
    discriminant: 'trustOnUs',
    value: {
      title: 'Ils nous font confiance',
      logos: [],
    },
  },
];
---
<Layout
  lang="fr"
  title="Agitech — Partenaire Odoo"
  description="Agitech, partenaire Odoo pour l'implémentation, la migration et le support ERP."
  canonical="https://agitech.io/"
>
  <Header slot="header" lang="fr" />
  <main>
    <BlockRenderer blocks={blocks} />
  </main>
  <Footer slot="footer" lang="fr" />
</Layout>
