---
export interface Props {
  lang: 'fr' | 'en';
  title: string;
  description: string;
  canonical?: string;
  ogLocale?: string;
  jsonLd?: Record<string, unknown>;
  robotsNoIndex?: boolean;
  /** Set on the homepage only — flips the dark-section corner glow to the opposite
   * corner from every other page (see .is-home rules in style.css). */
  bodyClass?: string;
  /** Calendly widget + the postMessage listener that redirects to the "merci-rdv"
   * thank-you page on booking — only needed on pages with the Calendly embed. */
  includeContactScripts?: boolean;
}

const {
  lang, title, description,
  canonical, ogLocale = lang === 'fr' ? 'fr_BE' : 'en_US',
  jsonLd,
  // Site not live yet — agitech.io (WP) is still the indexed site. Defaults to noindex
  // everywhere so this preview never competes with it in search. Flip to false (or set
  // per-page) only once this deployment actually replaces the live site.
  robotsNoIndex = true,
  bodyClass,
  includeContactScripts = false,
} = Astro.props;

const rdvThankYouPath = lang === 'en' ? '/en/thank-you-meeting/' : '/merci-rdv/';

// FR = default locale (no prefix), EN under /en/ — matches current WP/Polylang URLs.
const altPath = canonical
  ? (lang === 'fr' ? canonical.replace('https://agitech.io', 'https://agitech.io/en') : canonical.replace('/en', ''))
  : undefined;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{robotsNoIndex && <meta name="robots" content="noindex, nofollow">}
<title>{title}</title>
<meta name="description" content={description}>
{canonical && (
  <>
    <link rel="canonical" href={canonical}>
    {altPath && <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={altPath}>}
    <link rel="alternate" hreflang="x-default" href="https://agitech.io/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="Agitech">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
  </>
)}
<link rel="icon" href="/assets/img/agitech-logo-dark.svg">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<!-- Same base design system as agifid.be (fonts, tokens, layout primitives), recolored to
     Agitech's own mauve (#984895, from the official wordmark) instead of agifid's teal. -->
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body class={bodyClass}>
<slot name="header" />
<slot />
<slot name="footer" />
<script>
  const burgerBtn = document.getElementById('burgerBtn');
  const mainMenu = document.getElementById('mainMenu');
  burgerBtn?.addEventListener('click', () => mainMenu?.classList.toggle('open'));
</script>
{includeContactScripts && (
  <script is:inline define:vars={{ rdvThankYouPath }}>
    // Calendly is a heavy third-party script only needed once the visitor reaches the
    // contact section — loaded lazily on scroll-into-view instead of on every page load.
    let calendlyPromise = null;
    function loadCalendly() {
      if (!calendlyPromise) {
        calendlyPromise = new Promise((resolve) => {
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.onload = resolve;
          document.body.appendChild(s);
        });
      }
      return calendlyPromise;
    }
    const contactSection = document.getElementById('contact');
    if (contactSection) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadCalendly();
          observer.disconnect();
        }
      }, { rootMargin: '600px' });
      observer.observe(contactSection);
    }

    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://calendly.com' || !e.data || !e.data.event) return;

      // The embedded Calendly widget has its own confirmation inside the iframe: without
      // this, a booking never goes through a thank-you page and is never tracked.
      if (e.data.event === 'calendly.event_scheduled') {
        window.location.href = rdvThankYouPath;
      }

      // Calendly defaults to a fixed height, which creates a scroll inside the iframe (a
      // "page inside the page"). Resync the widget's height to its real content so only
      // the page itself scrolls.
      if (e.data.event === 'calendly.page_height') {
        const widget = document.querySelector('.calendly-inline-widget');
        if (widget && e.data.payload && e.data.payload.height) {
          widget.style.height = e.data.payload.height + 'px';
        }
      }
    });
  </script>
)}
</body>
</html>
